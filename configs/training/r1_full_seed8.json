{
    "schema_version": 1,
    "name": "r1_full_seed8",
    "description": "R1: full reward (default RewardConfig). Seed 8 replicate of grpo_run2 (R1 seed 7).",
    "base_model": "Qwen/Qwen2.5-7B-Instruct",
    "seed": 8,
    "num_train_examples": 256,
    "group_size": 8,
    "epochs": 1,
    "learning_rate": 2e-05,
    "epsilon": 0.2,
    "max_grad_norm": 1.0,
    "train_on_invalid": true,
    "save_every": 32,
    "dtype": "bfloat16",
    "gradient_checkpointing": true,
    "generation": {"max_new_tokens": 128, "do_sample": true, "temperature": 1.0, "top_p": 1.0},
    "lora": {
        "r": 16,
        "lora_alpha": 32,
        "lora_dropout": 0.0,
        "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
    },
    "environment": {"top_k": 3, "max_searches": 3},
    "reward": {}
}
