{
    "schema_version": 1,
    "name": "grpo_smoke",
    "base_model": "Qwen/Qwen2.5-7B-Instruct",
    "seed": 7,
    "num_train_examples": 64,
    "group_size": 4,
    "epochs": 1,
    "learning_rate": 1e-05,
    "epsilon": 0.2,
    "max_grad_norm": 1.0,
    "train_on_invalid": false,
    "save_every": 16,
    "dtype": "bfloat16",
    "gradient_checkpointing": true,
    "generation": {"max_new_tokens": 128, "do_sample": true, "temperature": 1.0, "top_p": 1.0},
    "lora": {
        "r": 16,
        "lora_alpha": 32,
        "lora_dropout": 0.0,
        "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
    },
    "environment": {"top_k": 3, "max_searches": 3},
    "reward": {}
}
